{
  "name": "INKORA - Weekly Manager Briefing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "d2194d0e-cd4b-4682-ae38-7d6cbf85beba",
      "name": "Every Monday morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        280
      ]
    },
    {
      "parameters": {
        "url": "https://printshop-ai.shabara123456.workers.dev/api/integrations/weekly-report",
        "sendHeaders": false,
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "614bb28c-0af1-446f-b23a-e7d6b06f6315",
      "name": "Fetch verified weekly report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        280
      ],
      "notes": "Select the saved INKORA Event Webhook Header Auth credential before activating. No shared secret is stored in this workflow file."
    },
    {
      "parameters": {
        "options": {
          "appendAttribution": false
        },
        "resource": "message",
        "subject": "INKORA - Weekly shop report",
        "message": "={{ 'WEEKLY MANAGER BRIEFING\\n' + $json.narrative + '\\n\\nVerified report data:\\n' + JSON.stringify({ period: $json.period, sales: $json.sales, low_stock_items: $json.low_stock_items, production: $json.production }, null, 2) }}",
        "authentication": "oAuth2",
        "emailType": "text",
        "sendTo": "={{ $json.to_email }}",
        "operation": "send"
      },
      "id": "f5964b33-d6c9-49d6-b4df-d3ddc96a6486",
      "name": "Email manager",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        760,
        280
      ],
      "notes": "Select the saved Gmail OAuth credential before activating. Uses the Gmail API over HTTPS; SMTP is blocked on Render Free."
    }
  ],
  "connections": {
    "Every Monday morning": {
      "main": [
        [
          {
            "node": "Fetch verified weekly report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch verified weekly report": {
      "main": [
        [
          {
            "node": "Email manager",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Cairo"
  },
