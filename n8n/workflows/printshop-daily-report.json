{
  "name": "PrintShop AI - Daily Operations Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 18
            }
          ]
        }
      },
      "id": "0fdba85b-8492-49f4-a131-3bf3c27aa0d5",
      "name": "Every evening",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        280
      ]
    },
    {
      "parameters": {
        "url": "https://printshop-ai.shabara123456.workers.dev/api/integrations/daily-report",
        "sendHeaders": false,
        "options": {
          "timeout": 15000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "44fa6550-17fd-4920-a177-50153b7a2f87",
      "name": "Fetch live shop report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        280
      ],
      "notes": "Select the saved INKORA Event Webhook Header Auth credential before activating. No shared secret is stored in this workflow file."
    },
    {
      "parameters": {
        "options": {
          "appendAttribution": false
        },
        "resource": "message",
        "subject": "PrintShop AI - Daily shop report",
        "message": "={{ JSON.stringify($json, null, 2) }}",
        "authentication": "oAuth2",
        "emailType": "text",
        "sendTo": "={{ $json.to_email }}",
        "operation": "send"
      },
      "id": "3b18657a-b638-46cb-a4e6-c087a3144ed2",
      "name": "Email manager report",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        760,
        280
      ],
      "notes": "Select the saved Gmail OAuth credential before activating. Uses the Gmail API over HTTPS; SMTP is blocked on Render Free."
    }
  ],
  "connections": {
    "Every evening": {
      "main": [
        [
          {
            "node": "Fetch live shop report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch live shop report": {
      "main": [
        [
          {
            "node": "Email manager report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Cairo"
  },
  "versionId": "6d031c54-b4b6-442a-89a5-436f79b499f1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
