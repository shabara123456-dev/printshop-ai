# Backend runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase keys. The secret key is server-only and must never reach a browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Local development defaults to Hermes CLI. For the public Cloudflare Worker,
# set HERMES_BASE_URL and HERMES_API_KEY as encrypted Worker secrets to connect
# to an HTTPS Hermes API server. Never expose the API key to the browser.
HERMES_CLI_PATH=hermes.exe
HERMES_PROVIDER=
HERMES_MODEL=
HERMES_BASE_URL=
HERMES_API_KEY=
# Optional health endpoints; defaults are <HERMES_BASE_URL>/health and
# <N8N_WEBHOOK_BASE_URL>/healthz for a standard Hermes/n8n host.
HERMES_HEALTH_URL=

# Free community-powered image generation for manager-approved marketing drafts.
# Uses AI Horde's anonymous account by default; queue times vary and prompts go to volunteer-run workers.
# Set MARKETING_IMAGE_PROVIDER=off to disable, or AI_HORDE_API_KEY to use your own free account/prioritization.
MARKETING_IMAGE_PROVIDER=ai_horde
AI_HORDE_API_KEY=
AI_HORDE_BASE_URL=https://stablehorde.net/api/v2

# Server-only key for the restricted Hermes MCP bridge and Cloudflare's HTTPS /mcp endpoint.
# Use the same value for Worker HERMES_TOOL_API_KEY; never expose it in the browser.
HERMES_TOOL_API_KEY=
# Enable proposal-and-confirm manager actions from Hermes after setting the authorized
# manager profile UUID and verifying the Hermes MCP toolset on this machine.
HERMES_WRITE_TOOLS_ENABLED=false
HERMES_MANAGER_USER_ID=

# Optional n8n automation delivery. Base URL is the n8n instance's public base URL.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_HEALTH_URL=
# Optional manager-only, read-only runtime status from n8n's Public API.
# If omitted, the API reuses N8N_WEBHOOK_BASE_URL and appends /api/v1.
N8N_API_BASE_URL=
N8N_API_KEY=
PRINTSHOP_MANAGER_EMAIL=

# Optional observability and cost tracking
LOG_LEVEL=info
