# Backend runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase keys. The secret key is server-only and must never reach a browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Hermes owns model/provider selection. The backend invokes the installed Hermes CLI
# and restricts each app request to the PrintShop MCP toolset.
HERMES_CLI_PATH=hermes.exe
HERMES_PROVIDER=
HERMES_MODEL=

# Free community-powered image generation for manager-approved marketing drafts.
# Uses AI Horde's anonymous account by default; queue times vary and prompts go to volunteer-run workers.
# Set MARKETING_IMAGE_PROVIDER=off to disable, or AI_HORDE_API_KEY to use your own free account/prioritization.
MARKETING_IMAGE_PROVIDER=ai_horde
AI_HORDE_API_KEY=
AI_HORDE_BASE_URL=https://stablehorde.net/api/v2

# Separate secret for the restricted, allowlisted PrintShop manager tools used by Hermes MCP.
HERMES_TOOL_API_KEY=
# Enable proposal-and-confirm manager actions from Hermes after setting the authorized
# manager profile UUID and verifying the Hermes MCP toolset on this machine.
HERMES_WRITE_TOOLS_ENABLED=false
HERMES_MANAGER_USER_ID=

# Optional n8n automation delivery. Base URL is the n8n instance's public base URL.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
PRINTSHOP_MANAGER_EMAIL=

# Optional observability and cost tracking
LOG_LEVEL=info
